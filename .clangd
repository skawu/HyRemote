# clangd / clang-tooling configuration.
#
# The project already generates a compilation database (HyRemoteProjectOptions.cmake sets
# CMAKE_EXPORT_COMPILE_COMMANDS), but CMake writes it inside the build directory, e.g.
# build/all/compile_commands.json - not at the repository root. clangd only auto-discovers a
# database in the file's parent directories or in a "build/" subdirectory of one of them, so
# without this file it falls back to heuristic flags, never sees -Icore/include (or the Qt include
# paths in the spikes) and reports
#     [pp_file_not_found] Line 1: 'hyremote/core/capabilities.hpp' file not found
# plus a cascade of "unknown type name" errors for every Core translation unit.
#
# Point clangd at the directory that holds the database. Use whichever directory was configured
# locally ("build/all" is the full build used by the CI-style ctest run; "build/core" also works
# for Core-only files). Regenerate it with:
#     cmake -S . -B build/all -G Ninja -DCMAKE_BUILD_TYPE=Release -DHYREMOTE_BUILD_CORE=ON \
#           -DHYREMOTE_BUILD_TESTS=ON -DHYREMOTE_BUILD_SPIKES=ON
CompileFlags:
  CompilationDatabase: build/all
