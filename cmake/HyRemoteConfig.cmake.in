@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)

if(@HYREMOTE_PACKAGE_WITH_REMOTE_ACCESS@)
    find_dependency(Qt6 6.8 COMPONENTS Core Network)
endif()

if(@HYREMOTE_PACKAGE_WITH_WIDGETS@)
    find_dependency(Qt6 6.8 COMPONENTS Widgets)
endif()

if(@HYREMOTE_PACKAGE_WITH_QUICK@)
    find_dependency(Qt6 6.8 COMPONENTS Quick)
endif()

if(@HYREMOTE_PACKAGE_WITH_QML@)
    find_dependency(Qt6 6.8 COMPONENTS Qml)
    set(HyRemote_QML_IMPORT_PATH "${PACKAGE_PREFIX_DIR}/@HYREMOTE_PACKAGE_QML_IMPORT_SUBDIR@")
endif()

set(HyRemote_QPA_AVAILABLE @HYREMOTE_PACKAGE_WITH_QPA@)
if(HyRemote_QPA_AVAILABLE)
    # This is product metadata, not a broad Qt compatibility claim. hyremote_deploy(... QPA)
    # requires the consumer Qt runtime to match this exact private-ABI line.
    set(HyRemote_QPA_QT_VERSION "@HYREMOTE_PACKAGE_QPA_QT_VERSION@")
    # The normal V1 product facade is always a shared library. Core may additionally be shared when
    # a low-level SDK build opts into BUILD_SHARED_LIBS.
    set(HyRemote_QPA_SHARED_RUNTIME @HYREMOTE_PACKAGE_QPA_SHARED_RUNTIME@)
    set(HyRemote_QPA_CORE_SHARED @HYREMOTE_PACKAGE_QPA_CORE_SHARED@)
else()
    set(HyRemote_QPA_QT_VERSION "")
    set(HyRemote_QPA_SHARED_RUNTIME FALSE)
    set(HyRemote_QPA_CORE_SHARED FALSE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/HyRemoteTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/HyRemoteDeploy.cmake")

check_required_components(HyRemote)
