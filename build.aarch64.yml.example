# HyRemote AArch64 嵌入式 Linux 交叉编译 profile 示例。
#
# 用法：
#   1. 复制为 build.aarch64.yml；
#   2. 修改 qt.prefix、compiler.toolchain、cmake.CMAKE_SYSROOT 和工具链前缀；
#   3. 执行：
#        build.cmd clean
#        build.cmd build --config=build.aarch64.yml
#
# 这样命令行只有一个 --config，平台差异集中在本文件。
# 这是一份构建配置示例，不代表 ARM64 运行时兼容性已经验收。
version: 1

build:
  type: Release
  directory: build
  generator: Ninja
  jobs: auto
  # 交叉编译通常不构建示例，除非目标板需要自测。
  examples: false

qt:
  # 必须是目标架构的 Qt 6.8.3，不能是主机 Qt。
  prefix: /opt/qt-6.8.3-aarch64

compiler:
  # 工具链文件会设置 aarch64-linux-gnu-gcc/g++；若工具链不在默认路径，
  # 在 cmake.HYREMOTE_TOOLCHAIN_PREFIX 中指定前缀。
  toolchain: cmake/toolchains/aarch64-linux-gnu.cmake

integrations:
  cpp: false
  qml: false
  generic: false
  qpa: true

transport:
  security: false

tests:
  build: false
  run: false

cmake:
  # 目标 sysroot，按实际板卡工具链修改。
  CMAKE_SYSROOT: /opt/aarch64-sysroot
  # 工具链没有使用默认 aarch64-linux-gnu- 前缀时填写，例如：
  # HYREMOTE_TOOLCHAIN_PREFIX: /opt/gcc-arm/bin/aarch64-none-linux-gnu-
  # 目标板 pkg-config 路径通常也需要放进 env。
  # env:
  #   PKG_CONFIG_PATH: /opt/aarch64-sysroot/usr/lib/pkgconfig
