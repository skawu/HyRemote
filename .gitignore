# Tool byte-code and caches.
# Tool-specific directories (editors, agent workspaces) belong in a local or global exclude rather than in
# the product's ignore file. These two lines are the part that is inert for every contributor, and without
# them a plain `git add -A` commits generated byte-code.
__pycache__/
*.pyc

# The OpenSSL submodule was removed (the build uses the OpenSSL from the environment). A checkout from before that
# removal can still have the directory on disk, and plain `git add -A` used to stage it back as an embedded
# repository, so it is ignored rather than left to chance.
/third_party/

# `aqt install-qt`, which the CI matrix and a local setup both run, writes its installer log into the working directory.
# It is 300 lines of installer output rather than a repository artifact, and a plain `git add -A` committed it once.
aqtinstall.log

# `check_release_metadata.cmake` writes its bilingual note fixtures under
# `${CMAKE_CURRENT_BINARY_DIR}`. When the check is invoked with `cmake -P` from
# the repository root, that resolves to the root; the directory is generated
# evidence, not product source.
hyremote-release-notes-fixtures/

# CodeBuddy: explicitly allowlist shared project entry/Skill; ignore all other local state.
.codebuddy/*
!.codebuddy/CODEBUDDY.md
!.codebuddy/skills/
.codebuddy/skills/*
!.codebuddy/skills/engineering-task-execution/
.codebuddy/skills/engineering-task-execution/*
!.codebuddy/skills/engineering-task-execution/SKILL.md
