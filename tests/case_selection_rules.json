{
  "version": 1,
  "authority": [
    "docs/internal/test-strategy.md",
    "docs/internal/test-system-architecture.md",
    "tests/TEST_CATALOG.md",
    "tests/EXECUTION_MANUAL.md"
  ],
  "rules": [
    {
      "id": "quick-native",
      "prefixes": [
        "src/runtime/src/quick/",
        "src/runtime/tests/test_quick_capture.cpp"
      ],
      "cases": [
        "hyremote-quick-capture-test",
        "hyremote-quick-gl-pbo-session-test",
        "hyremote-runtime-dll-lifecycle-test"
      ],
      "reason": "Qt Quick native/public capture and GL worker lifecycle; DLL case is Windows capability-guarded"
    },
    {
      "id": "quick-d3d11",
      "prefixes": [
        "src/runtime/src/quick/quick_d3d11_staging_capture_source.cpp",
        "src/runtime/src/quick/quick_d3d11_staging_capture_source.hpp"
      ],
      "cases": [
        "hyremote-quick-capture-test",
        "hyremote-runtime-dll-d3d11-lifecycle-test"
      ],
      "reason": "D3D11 staging and guarded Windows DLL lifecycle"
    },
    {
      "id": "core",
      "prefixes": [
        "src/core/"
      ],
      "cases": [
        "hyremote-core-test-frame-lifetime",
        "hyremote-core-test-mailbox",
        "hyremote-core-test-transport-handoff",
        "hyremote-core-test-session-lifecycle",
        "hyremote-cpp-installed-consumers"
      ],
      "reason": "Core owned frame, queue and session contracts"
    },
    {
      "id": "runtime",
      "prefixes": [
        "src/runtime/"
      ],
      "cases": [
        "hyremote-viewer-capture-demand-test",
        "hyremote-runtime-diagnostics-test"
      ],
      "reason": "Shared Runtime admission and diagnostics; manual impact review must add affected cases"
    },
    {
      "id": "rfb",
      "prefixes": [
        "src/integrations/cpp/tests/rfb_test_server.cpp",
        "src/integrations/cpp/tests/rfb_product_fit.py",
        "src/runtime/src/transport/"
      ],
      "cases": [
        "hyremote-rfb-wire-robustness-test",
        "hyremote-rfb-multi-client-input-test"
      ],
      "reason": "RFB wire and multi-viewer input correctness; authentication sources also require the security-on contract"
    },
    {
      "id": "rfb-authentication",
      "prefixes": [
        "src/runtime/src/transport/vnc_auth.cpp",
        "src/runtime/src/transport/vnc_auth.hpp"
      ],
      "cases": [
        "hyremote-rfb-wire-robustness-test",
        "hyremote-rfb-vnc-auth-handshake-test",
        "hyremote-vnc-auth-test"
      ],
      "reason": "VNC credential primitive and wire negotiation; authenticated cases are security-on only"
    },
    {
      "id": "runtime-lifecycle",
      "prefixes": [
        "src/runtime/src/access_instance.cpp",
        "src/runtime/src/access_instance.hpp"
      ],
      "cases": [
        "hyremote-viewer-capture-demand-test",
        "hyremote-runtime-diagnostics-test",
        "hyremote-runtime-notifications-test",
        "hyremote-remoteaccess-test",
        "hyremote-cpp-installed-consumers"
      ],
      "reason": "Shared Runtime state and session lifecycle reach the installed facade"
    },
    {
      "id": "cpp-facade",
      "prefixes": [
        "src/integrations/cpp/include/",
        "src/integrations/cpp/src/"
      ],
      "cases": [
        "hyremote-remoteaccess-test",
        "hyremote-cpp-installed-consumers"
      ],
      "reason": "Public C++ SDK source/installed consumer contract"
    },
    {
      "id": "cmake",
      "prefixes": [
        "cmake/",
        "build.cmd",
        "CMakeLists.txt",
        "src/runtime/CMakeLists.txt",
        "src/runtime/tests/CMakeLists.txt"
      ],
      "cases": [
        "hyremote-build-authority-selftest",
        "hyremote-release-readiness-facts-layout",
        "hyremote-cpp-installed-consumers"
      ],
      "reason": "Build/configure and repository authority; full gate may be required by existing manual"
    },
    {
      "id": "governance",
      "prefixes": [
        ".github/",
        "tests/release-readiness/"
      ],
      "cases": [
        "hyremote-ci-scope-self-test",
        "hyremote-branch-name-gate-self-test"
      ],
      "reason": "CI/release governance regression"
    },
    {
      "id": "docs",
      "prefixes": [
        "docs/",
        "README.md",
        "README_EN.md"
      ],
      "cases": [
        "hyremote-release-readiness-facts-layout"
      ],
      "reason": "Documentation contracts only; unrelated docs need no Qt runtime run"
    },
    {
      "id": "test-inventory",
      "prefixes": [
        "tests/",
        "tools/test/"
      ],
      "cases": [
        "hyremote-build-authority-selftest"
      ],
      "reason": "Test registration/selector authority; affected test logic must be added by owner"
    }
  ],
  "exception": [
    "A case name here is an existing TEST_CATALOG.md CTest identity; capability guards still control registration.",
    "This read-only plan is not acceptance, cannot override existing CI classifier/branch protection, and cannot authorize a skipped mandatory gate.",
    "A source change with no matching rule is an error; manual impact review is required before assigning additional cases.",
    "Risk rules are additive across all changed files; a most-specific source path match never cancels declared cross-cutting ABI/security/QML test obligations."
  ],
  "risk_rules": [
    {
      "id": "security-auth",
      "cases": [
        "hyremote-security-descriptor-test",
        "hyremote-vnc-auth-test",
        "hyremote-rfb-vnc-auth-handshake-test"
      ],
      "reason": "Credential/auth changes require descriptor and security-on wire/crypto cases; unsupported security-on capability blocks acceptance"
    },
    {
      "id": "public-sdk-abi",
      "cases": [
        "hyremote-remoteaccess-test",
        "hyremote-cpp-installed-consumers"
      ],
      "reason": "Installed C++ SDK ABI/source consumer contract requires clean installed consumer test"
    },
    {
      "id": "qml-registration",
      "cases": [
        "hyremote-qml-module-test",
        "hyremote-qml-installed-consumer"
      ],
      "reason": "QML URI/type registration and installed import contract must both be verified"
    }
  ]
}
